# Optional settings for `docker compose`. Copy to .env and adjust.

# Leave empty and the API container generates one and keeps it in its volume.
# To set it yourself: ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
SECRET_KEY_BASE=

# Load the demo users, jobs and applications on start (safe to repeat).
SEED_DEMO_DATA=true
SEED_PASSWORD=shortlist-demo

# Host port for the web app.
WEB_PORT=8080

# Only needed when the client is served from a different origin than the API.
CORS_ORIGINS=http://localhost:5173
